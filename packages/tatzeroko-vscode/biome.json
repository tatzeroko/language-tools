{
	"$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
	"root": false,
	"extends": "//",
	"vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },
	"files": { "ignoreUnknown": false, "includes": ["**"] },
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"style": {
				"useBlockStatements": "warn",
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": { "kind": "importNamespace" },
								"formats": ["camelCase", "PascalCase"]
							},
							{
								"selector": { "kind": "importAlias" },
								"formats": ["camelCase", "PascalCase"]
							}
						]
					}
				},
				"useThrowOnlyError": "warn"
			},
			"suspicious": { "noDoubleEquals": "warn" }
		}
	},
	"javascript": { "formatter": { "quoteStyle": "double" }, "globals": [] },
	"overrides": [{ "includes": ["**/*.ts"] }, { "includes": ["**/*.ts"] }]
}
