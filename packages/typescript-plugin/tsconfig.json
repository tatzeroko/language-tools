{
	"compilerOptions": {
		"lib": ["ES2022"],
		"target": "ES2022",
		"moduleResolution": "node",
		"module": "commonjs",
		"outDir": "dist",
		"esModuleInterop": true,
		"strict": true,
		"declaration": true,
		"sourceMap": true,
		"composite": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
